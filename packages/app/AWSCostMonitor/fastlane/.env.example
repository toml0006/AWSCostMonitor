# Copy to fastlane/.env (gitignored) or export these in your shell before running
# fastlane. Auth is via an App Store Connect API key.
#
# Get the issuer ID from App Store Connect → Users and Access → Integrations →
# App Store Connect API. The .p8 key stays in ~/.appstoreconnect/private_keys/
# and is never committed.

ASC_KEY_ID=A883B9G6LZ
ASC_ISSUER_ID=your-issuer-uuid-here
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_A883B9G6LZ.p8
